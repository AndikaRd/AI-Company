# ==========================================
# Virtual AI Company (VAC) - Environment Config
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/virtual_ai_company?schema=public

# Database Credentials for Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=virtual_ai_company
POSTGRES_PORT=5432

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Frontend Configuration
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000

# ==========================================
# AI Provider Architecture Configuration
# ==========================================
# Default Provider: OLLAMA (Local First)
AI_DEFAULT_PROVIDER=OLLAMA
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen3.5:4b

# Future Cloud Provider Credentials (Optional)
# Secrets must never be exposed to the client
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o
