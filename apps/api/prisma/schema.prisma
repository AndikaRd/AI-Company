// Virtual AI Company (VAC) - Prisma Schema
// Database Engine: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum EmployeeStatus {
  ACTIVE
  IDLE
  BUSY
  OFFLINE
}

enum SeniorityLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  PRINCIPAL
  EXECUTIVE
}

enum AiProvider {
  OLLAMA
  OPENAI
  ANTHROPIC
}

enum AutonomyLevel {
  MANUAL
  SUPERVISED
  AUTONOMOUS
}

enum MemoryRetention {
  SESSION
  LONG_TERM
}

model Company {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  industry    String?
  website     String?
  status      CompanyStatus  @default(ACTIVE)
  departments Department[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("companies")
}

model Department {
  id          String     @id @default(uuid())
  name        String
  slug        String
  description String?
  floorZone   String?    @map("floor_zone")
  color       String?
  companyId   String     @map("company_id")
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("departments")
}

model Employee {
  id               String              @id @default(uuid())
  employeeCode     String?             @unique @map("employee_code")
  firstName        String              @map("first_name")
  lastName         String              @map("last_name")
  role             String
  jobTitle         String?             @map("job_title")
  seniority        SeniorityLevel      @default(MID)
  personality      String?             @db.Text
  primaryExpertise String?             @map("primary_expertise")
  skills           Json?
  email            String              @unique
  avatarUrl        String?             @map("avatar_url")
  workstationId    String?             @map("workstation_id")
  isAiAgent        Boolean             @default(true) @map("is_ai_agent")
  status           EmployeeStatus      @default(ACTIVE)
  departmentId     String              @map("department_id")
  department       Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  supervisorId     String?             @map("supervisor_id")
  supervisor       Employee?           @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates     Employee[]          @relation("EmployeeSupervisor")
  agentConfig      AgentConfiguration?
  conversations    Conversation[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([supervisorId])
  @@map("employees")
}

model AgentConfiguration {
  id               String          @id @default(uuid())
  employeeId       String          @unique @map("employee_id")
  employee         Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  provider         AiProvider      @default(OLLAMA)
  modelName        String          @default("qwen3.5:4b") @map("model_name")
  autonomyLevel    AutonomyLevel   @default(SUPERVISED) @map("autonomy_level")
  systemPrompt     String?         @map("system_prompt") @db.Text
  temperature      Float           @default(0.7)
  maxTokens        Int             @default(2048) @map("max_tokens")
  toolsEnabled     Json?           @map("tools_enabled")
  permissionConfig Json?           @map("permission_config")
  memoryRetention  MemoryRetention @default(SESSION) @map("memory_retention")
  memoryConfig     Json?           @map("memory_config")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("agent_configurations")
}

model Conversation {
  id          String    @id @default(uuid())
  title       String?
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  messages    Message[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     String       @map("sender_type") // USER | AGENT | SYSTEM
  senderName     String       @map("sender_name")
  content        String       @db.Text
  thinking       String?      @db.Text
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}
