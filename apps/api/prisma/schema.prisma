// Virtual AI Company (VAC) - Prisma Schema
// Database Engine: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum EmployeeStatus {
  ACTIVE
  IDLE
  BUSY
  OFFLINE
}

enum SeniorityLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  PRINCIPAL
  EXECUTIVE
}

enum AiProvider {
  OLLAMA
  OPENAI
  ANTHROPIC
}

enum AutonomyLevel {
  MANUAL
  SUPERVISED
  AUTONOMOUS
}

enum MemoryRetention {
  SESSION
  LONG_TERM
}

enum TaskStatus {
  PENDING
  PLANNING
  IN_PROGRESS
  WAITING_APPROVAL
  REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExecutionStatus {
  PLANNING
  IN_PROGRESS
  WAITING_APPROVAL
  REVIEW
  COMPLETED
  FAILED
}

enum ToolCallStatus {
  SUCCESS
  FAILURE
  BLOCKED
  APPROVAL_REQUIRED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AgentMessageType {
  DIRECT_MESSAGE
  TASK_DELEGATION
  TASK_ACCEPTED
  TASK_REJECTED
  TASK_UPDATE
  TASK_COMPLETED
  QUERY
  RESPONSE
}

enum MemoryCategory {
  WORKING
  EPISODIC
  SEMANTIC
}

enum MemoryScope {
  EMPLOYEE_PRIVATE
  PROJECT_SHARED
  COMPANY_SHARED
  TASK_SCOPED
}

enum MemoryStatus {
  ACTIVE
  ARCHIVED
  EXPIRED
  DELETED
}

enum MemorySourceType {
  TASK_EXECUTION
  AGENT_DECISION
  AGENT_COMMUNICATION
  KNOWLEDGE_DOCUMENT
  EXECUTIVE_DIRECTIVE
  MANUAL_ENTRY
}

enum KnowledgeCategory {
  CODING_STANDARDS
  ARCHITECTURE_GUIDELINES
  COMPANY_POLICY
  PRODUCT_SPECIFICATION
  SECURITY_PRACTICES
  QA_VERIFICATION
  GENERAL
}

model Company {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  industry    String?
  website     String?
  status      CompanyStatus  @default(ACTIVE)
  departments Department[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("companies")
}

model Department {
  id            String              @id @default(uuid())
  name          String
  slug          String
  description   String?
  floorZone     String?             @map("floor_zone")
  color         String?
  companyId     String              @map("company_id")
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees     Employee[]
  memories      Memory[]            @relation("DepartmentMemories")
  knowledgeDocs KnowledgeDocument[] @relation("DepartmentKnowledgeDocs")
  ceoCommands   CeoCommand[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("departments")
}

model Employee {
  id                String              @id @default(uuid())
  employeeCode      String?             @unique @map("employee_code")
  firstName         String              @map("first_name")
  lastName          String              @map("last_name")
  role              String
  jobTitle          String?             @map("job_title")
  seniority         SeniorityLevel      @default(MID)
  personality       String?             @db.Text
  primaryExpertise  String?             @map("primary_expertise")
  skills            Json?
  responsibilities  Json?
  email             String              @unique
  avatarUrl         String?             @map("avatar_url")
  workstationId     String?             @map("workstation_id")
  isAiAgent         Boolean             @default(true) @map("is_ai_agent")
  status            EmployeeStatus      @default(ACTIVE)
  departmentId      String              @map("department_id")
  department        Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  supervisorId      String?             @map("supervisor_id")
  supervisor        Employee?           @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates      Employee[]          @relation("EmployeeSupervisor")
  agentConfig       AgentConfiguration?
  conversations     Conversation[]
  tasks             Task[]              @relation("AssignedTasks")
  delegatedTasks    Task[]              @relation("DelegatedTasks")
  sentMessages      AgentMessage[]      @relation("SentAgentMessages")
  receivedMessages  AgentMessage[]      @relation("ReceivedAgentMessages")
  memories          Memory[]            @relation("EmployeeMemories")
  authoredKnowledge KnowledgeDocument[] @relation("AuthoredKnowledgeDocs")
  memoryAccessLogs  MemoryAccessLog[]   @relation("AccessedMemories")
  needs             EmployeeNeeds?
  lifeState         EmployeeLifeState?
  lifeEvents        EmployeeLifeEvent[]
  ceoCommands       CeoCommand[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([supervisorId])
  @@map("employees")
}

model AgentConfiguration {
  id               String          @id @default(uuid())
  employeeId       String          @unique @map("employee_id")
  employee         Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  provider         AiProvider      @default(OLLAMA)
  modelName        String          @default("qwen3.5:4b") @map("model_name")
  autonomyLevel    AutonomyLevel   @default(SUPERVISED) @map("autonomy_level")
  systemPrompt     String?         @map("system_prompt") @db.Text
  temperature      Float           @default(0.7)
  maxTokens        Int             @default(2048) @map("max_tokens")
  toolsEnabled     Json?           @map("tools_enabled")
  permissionConfig Json?           @map("permission_config")
  memoryRetention  MemoryRetention @default(SESSION) @map("memory_retention")
  memoryConfig     Json?           @map("memory_config")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("agent_configurations")
}

model Conversation {
  id          String    @id @default(uuid())
  title       String?
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  messages    Message[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     String       @map("sender_type") // USER | AGENT | SYSTEM
  senderName     String       @map("sender_name")
  content        String       @db.Text
  thinking       String?      @db.Text
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

model Task {
  id                    String            @id @default(uuid())
  title                 String
  description           String            @db.Text
  status                TaskStatus        @default(PENDING)
  priority              TaskPriority      @default(MEDIUM)
  assignedEmployeeId    String            @map("assigned_employee_id")
  assignedEmployee      Employee          @relation("AssignedTasks", fields: [assignedEmployeeId], references: [id], onDelete: Cascade)
  delegatedByEmployeeId String?           @map("delegated_by_employee_id")
  delegatedBy           Employee?         @relation("DelegatedTasks", fields: [delegatedByEmployeeId], references: [id], onDelete: SetNull)
  parentTaskId          String?           @map("parent_task_id")
  parentTask            Task?             @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks              Task[]            @relation("TaskSubtasks")
  delegationDepth       Int               @default(0) @map("delegation_depth")
  requiredSkills        Json?             @map("required_skills")
  dependsOnTaskIds      Json?             @map("depends_on_task_ids")
  workspacePath         String?           @map("workspace_path")
  deliverables          Json?
  executions            TaskExecution[]
  approvalRequests      ApprovalRequest[]
  agentMessages         AgentMessage[]
  memories              Memory[]          @relation("TaskMemories")
  activeLifeStates      EmployeeLifeState[]
  ceoCommands           CeoCommand[]
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@index([assignedEmployeeId])
  @@index([delegatedByEmployeeId])
  @@index([parentTaskId])
  @@index([status])
  @@map("tasks")
}

model TaskExecution {
  id               String            @id @default(uuid())
  taskId           String            @map("task_id")
  task             Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId       String            @map("employee_id")
  status           ExecutionStatus   @default(PLANNING)
  summary          String?           @db.Text
  deliverables     Json?
  startedAt        DateTime          @default(now()) @map("started_at")
  completedAt      DateTime?         @map("completed_at")
  error            String?           @db.Text
  toolLogs         ToolExecutionLog[]
  approvalRequests ApprovalRequest[]

  @@index([taskId])
  @@map("task_executions")
}

model ToolExecutionLog {
  id              String            @id @default(uuid())
  taskExecutionId String            @map("task_execution_id")
  taskExecution   TaskExecution     @relation(fields: [taskExecutionId], references: [id], onDelete: Cascade)
  toolName        String            @map("tool_name")
  input           Json
  output          Json?
  exitCode        Int?              @map("exit_code")
  durationMs      Int?              @map("duration_ms")
  riskLevel       String            @map("risk_level")
  status          ToolCallStatus    @default(SUCCESS)
  error           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([taskExecutionId])
  @@index([toolName])
  @@map("tool_execution_logs")
}

model ApprovalRequest {
  id              String         @id @default(uuid())
  taskId          String         @map("task_id")
  task            Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskExecutionId String         @map("task_execution_id")
  taskExecution   TaskExecution  @relation(fields: [taskExecutionId], references: [id], onDelete: Cascade)
  toolName        String         @map("tool_name")
  actionSummary   String         @map("action_summary")
  input           Json
  riskLevel       String         @map("risk_level")
  status          ApprovalStatus @default(PENDING)
  reviewedBy      String?        @map("reviewed_by")
  reviewedAt      DateTime?      @map("reviewed_at")
  rejectionReason String?        @map("rejection_reason")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([taskId])
  @@index([taskExecutionId])
  @@index([status])
  @@map("approval_requests")
}

model AgentMessage {
  id                  String           @id @default(uuid())
  senderEmployeeId    String           @map("sender_employee_id")
  senderEmployee      Employee         @relation("SentAgentMessages", fields: [senderEmployeeId], references: [id], onDelete: Cascade)
  recipientEmployeeId String           @map("recipient_employee_id")
  recipientEmployee   Employee         @relation("ReceivedAgentMessages", fields: [recipientEmployeeId], references: [id], onDelete: Cascade)
  taskId              String?          @map("task_id")
  task                Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  correlationId       String           @map("correlation_id")
  messageType         AgentMessageType @default(DIRECT_MESSAGE) @map("message_type")
  content             String           @db.Text
  payload             Json?
  readAt              DateTime?        @map("read_at")
  createdAt           DateTime         @default(now()) @map("created_at")

  @@index([senderEmployeeId])
  @@index([recipientEmployeeId])
  @@index([taskId])
  @@index([correlationId])
  @@map("agent_messages")
}

model Memory {
  id              String            @id @default(uuid())
  category        MemoryCategory
  scope           MemoryScope
  status          MemoryStatus      @default(ACTIVE)
  title           String
  content         String            @db.Text
  summary         String?           @db.Text
  tags            Json?
  ownerEmployeeId String?           @map("owner_employee_id")
  ownerEmployee   Employee?         @relation("EmployeeMemories", fields: [ownerEmployeeId], references: [id], onDelete: SetNull)
  departmentId    String?           @map("department_id")
  department      Department?       @relation("DepartmentMemories", fields: [departmentId], references: [id], onDelete: SetNull)
  projectId       String?           @map("project_id")
  taskId          String?           @map("task_id")
  task            Task?             @relation("TaskMemories", fields: [taskId], references: [id], onDelete: SetNull)
  importance      Float             @default(0.5)
  confidence      Float             @default(1.0)
  accessCount     Int               @default(0) @map("access_count")
  lastAccessedAt  DateTime?         @map("last_accessed_at")
  expiresAt       DateTime?         @map("expires_at")
  metadata        Json?
  embedding       Json?
  sourceId        String?           @unique @map("source_id")
  source          MemorySource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  accessLogs      MemoryAccessLog[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([ownerEmployeeId])
  @@index([category])
  @@index([scope])
  @@index([status])
  @@index([taskId])
  @@index([projectId])
  @@index([departmentId])
  @@map("memories")
}

model MemorySource {
  id              String           @id @default(uuid())
  sourceType      MemorySourceType @map("source_type")
  sourceRef       String?          @map("source_ref")
  isVerified      Boolean          @default(false) @map("is_verified")
  verifiedBy      String?          @map("verified_by")
  verifiedAt      DateTime?        @map("verified_at")
  confidenceScore Float            @default(0.8) @map("confidence_score")
  rawContent      String?          @map("raw_content") @db.Text
  memory          Memory?
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([sourceType])
  @@index([isVerified])
  @@map("memory_sources")
}

model KnowledgeDocument {
  id               String            @id @default(uuid())
  title            String
  slug             String            @unique
  category         KnowledgeCategory @default(GENERAL)
  content          String            @db.Text
  summary          String?           @db.Text
  authorEmployeeId String?           @map("author_employee_id")
  authorEmployee   Employee?         @relation("AuthoredKnowledgeDocs", fields: [authorEmployeeId], references: [id], onDelete: SetNull)
  departmentId     String?           @map("department_id")
  department       Department?       @relation("DepartmentKnowledgeDocs", fields: [departmentId], references: [id], onDelete: SetNull)
  version          Int               @default(1)
  isApproved       Boolean           @default(true) @map("is_approved")
  approvedBy       String?           @map("approved_by")
  approvedAt       DateTime?         @map("approved_at")
  tags             Json?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([category])
  @@index([departmentId])
  @@index([isApproved])
  @@map("knowledge_documents")
}

model ProjectKnowledge {
  id                  String   @id @default(uuid())
  projectId           String   @map("project_id")
  title               String
  key                 String
  value               String   @db.Text
  isVerified          Boolean  @default(true) @map("is_verified")
  updatedByEmployeeId String?  @map("updated_by_employee_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([projectId, key])
  @@index([projectId])
  @@map("project_knowledge")
}

model MemoryAccessLog {
  id                   String    @id @default(uuid())
  memoryId             String    @map("memory_id")
  memory               Memory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  accessedByEmployeeId String    @map("accessed_by_employee_id")
  accessedByEmployee   Employee  @relation("AccessedMemories", fields: [accessedByEmployeeId], references: [id], onDelete: Cascade)
  taskId               String?   @map("task_id")
  action               String
  queryContext         String?   @map("query_context") @db.Text
  relevanceScore       Float?    @map("relevance_score")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([memoryId])
  @@index([accessedByEmployeeId])
  @@index([taskId])
  @@map("memory_access_logs")
}

enum LifeBehaviorState {
  WORKING
  DRINKING
  EATING
  RESTING
  SOCIALIZING
  WALKING
  RETURNING_TO_DESK
  ATTENDING_MEETING
  IDLE
}

model EmployeeNeeds {
  id          String   @id @default(uuid())
  employeeId  String   @unique @map("employee_id")
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  energy      Float    @default(100.0) // 0 - 100 (100 = fully rested, 0 = exhausted)
  hunger      Float    @default(100.0) // 0 - 100 (100 = fully satiated, 0 = starving)
  thirst      Float    @default(100.0) // 0 - 100 (100 = fully hydrated, 0 = parched)
  focus       Float    @default(100.0) // 0 - 100 (100 = deep focus, 0 = burned out)
  social      Float    @default(100.0) // 0 - 100 (100 = socially fulfilled, 0 = lonely)
  mood        Float    @default(100.0) // 0 - 100 (100 = ecstatic/motivated, 0 = demoralized)
  lastUpdated DateTime @default(now()) @map("last_updated")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([employeeId])
  @@map("employee_needs")
}

model EmployeeLifeState {
  id                    String             @id @default(uuid())
  employeeId            String             @unique @map("employee_id")
  employee              Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  behavior              LifeBehaviorState  @default(IDLE)
  currentLocationId     String             @default("workstation") @map("current_location_id")
  currentLocationName   String             @default("Workstation") @map("current_location_name")
  destinationLocationId String?            @map("destination_location_id")
  activeTaskId          String?            @map("active_task_id")
  activeTask            Task?              @relation(fields: [activeTaskId], references: [id], onDelete: SetNull)
  currentThought        String?            @map("current_thought")
  behaviorStartedAt     DateTime           @default(now()) @map("behavior_started_at")
  behaviorExpectedEndAt DateTime?          @map("behavior_expected_end_at")
  interruptedBehavior   LifeBehaviorState? @map("interrupted_behavior")
  lastSimulationUpdate  DateTime           @default(now()) @map("last_simulation_update")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  @@index([employeeId])
  @@index([behavior])
  @@index([currentLocationId])
  @@map("employee_life_states")
}

model EmployeeLifeEvent {
  id            String            @id @default(uuid())
  employeeId    String            @map("employee_id")
  employee      Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  eventType     String            @map("event_type")
  behavior      LifeBehaviorState
  locationId    String?           @map("location_id")
  locationName  String?           @map("location_name")
  details       String?           @db.Text
  thought       String?
  needsSnapshot Json?             @map("needs_snapshot")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([employeeId])
  @@index([eventType])
  @@index([createdAt])
  @@map("employee_life_events")
}

model CeoCommand {
  id                    String        @id @default(uuid())
  targetType            String        @map("target_type") // COMPANY | DEPARTMENT | EMPLOYEE
  targetId              String?       @map("target_id")
  targetName            String        @map("target_name")
  instruction           String        @db.Text
  status                String        @default("PENDING") // PENDING | ACKNOWLEDGED | IN_PROGRESS | COMPLETED | FAILED
  response              String?       @db.Text
  createdTaskId         String?       @map("created_task_id")
  createdTask           Task?         @relation(fields: [createdTaskId], references: [id], onDelete: SetNull)
  assignedEmployeeId    String?       @map("assigned_employee_id")
  assignedEmployee      Employee?     @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  departmentId          String?       @map("department_id")
  department            Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  metadata              Json?
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@index([targetType])
  @@index([status])
  @@index([assignedEmployeeId])
  @@map("ceo_commands")
}
