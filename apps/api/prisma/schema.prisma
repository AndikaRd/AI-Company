// Virtual AI Company (VAC) - Prisma Schema
// Database Engine: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum EmployeeStatus {
  ACTIVE
  IDLE
  BUSY
  OFFLINE
}

enum SeniorityLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  PRINCIPAL
  EXECUTIVE
}

enum AiProvider {
  OLLAMA
  OPENAI
  ANTHROPIC
}

enum AutonomyLevel {
  MANUAL
  SUPERVISED
  AUTONOMOUS
}

enum MemoryRetention {
  SESSION
  LONG_TERM
}

enum TaskStatus {
  PENDING
  PLANNING
  IN_PROGRESS
  WAITING_APPROVAL
  REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExecutionStatus {
  PLANNING
  IN_PROGRESS
  WAITING_APPROVAL
  REVIEW
  COMPLETED
  FAILED
}

enum ToolCallStatus {
  SUCCESS
  FAILURE
  BLOCKED
  APPROVAL_REQUIRED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Company {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  industry    String?
  website     String?
  status      CompanyStatus  @default(ACTIVE)
  departments Department[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("companies")
}

model Department {
  id          String     @id @default(uuid())
  name        String
  slug        String
  description String?
  floorZone   String?    @map("floor_zone")
  color       String?
  companyId   String     @map("company_id")
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("departments")
}

model Employee {
  id               String              @id @default(uuid())
  employeeCode     String?             @unique @map("employee_code")
  firstName        String              @map("first_name")
  lastName         String              @map("last_name")
  role             String
  jobTitle         String?             @map("job_title")
  seniority        SeniorityLevel      @default(MID)
  personality      String?             @db.Text
  primaryExpertise String?             @map("primary_expertise")
  skills           Json?
  email            String              @unique
  avatarUrl        String?             @map("avatar_url")
  workstationId    String?             @map("workstation_id")
  isAiAgent        Boolean             @default(true) @map("is_ai_agent")
  status           EmployeeStatus      @default(ACTIVE)
  departmentId     String              @map("department_id")
  department       Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  supervisorId     String?             @map("supervisor_id")
  supervisor       Employee?           @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates     Employee[]          @relation("EmployeeSupervisor")
  agentConfig      AgentConfiguration?
  conversations    Conversation[]
  tasks            Task[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([supervisorId])
  @@map("employees")
}

model AgentConfiguration {
  id               String          @id @default(uuid())
  employeeId       String          @unique @map("employee_id")
  employee         Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  provider         AiProvider      @default(OLLAMA)
  modelName        String          @default("qwen3.5:4b") @map("model_name")
  autonomyLevel    AutonomyLevel   @default(SUPERVISED) @map("autonomy_level")
  systemPrompt     String?         @map("system_prompt") @db.Text
  temperature      Float           @default(0.7)
  maxTokens        Int             @default(2048) @map("max_tokens")
  toolsEnabled     Json?           @map("tools_enabled")
  permissionConfig Json?           @map("permission_config")
  memoryRetention  MemoryRetention @default(SESSION) @map("memory_retention")
  memoryConfig     Json?           @map("memory_config")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("agent_configurations")
}

model Conversation {
  id          String    @id @default(uuid())
  title       String?
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  messages    Message[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     String       @map("sender_type") // USER | AGENT | SYSTEM
  senderName     String       @map("sender_name")
  content        String       @db.Text
  thinking       String?      @db.Text
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

model Task {
  id                 String            @id @default(uuid())
  title              String
  description        String            @db.Text
  status             TaskStatus        @default(PENDING)
  priority           TaskPriority      @default(MEDIUM)
  assignedEmployeeId String            @map("assigned_employee_id")
  assignedEmployee   Employee          @relation(fields: [assignedEmployeeId], references: [id], onDelete: Cascade)
  workspacePath      String?           @map("workspace_path")
  deliverables       Json?
  executions         TaskExecution[]
  approvalRequests   ApprovalRequest[]
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([assignedEmployeeId])
  @@index([status])
  @@map("tasks")
}

model TaskExecution {
  id               String            @id @default(uuid())
  taskId           String            @map("task_id")
  task             Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId       String            @map("employee_id")
  status           ExecutionStatus   @default(PLANNING)
  summary          String?           @db.Text
  deliverables     Json?
  startedAt        DateTime          @default(now()) @map("started_at")
  completedAt      DateTime?         @map("completed_at")
  error            String?           @db.Text
  toolLogs         ToolExecutionLog[]
  approvalRequests ApprovalRequest[]

  @@index([taskId])
  @@map("task_executions")
}

model ToolExecutionLog {
  id              String            @id @default(uuid())
  taskExecutionId String            @map("task_execution_id")
  taskExecution   TaskExecution     @relation(fields: [taskExecutionId], references: [id], onDelete: Cascade)
  toolName        String            @map("tool_name")
  input           Json
  output          Json?
  exitCode        Int?              @map("exit_code")
  durationMs      Int?              @map("duration_ms")
  riskLevel       String            @map("risk_level")
  status          ToolCallStatus    @default(SUCCESS)
  error           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([taskExecutionId])
  @@index([toolName])
  @@map("tool_execution_logs")
}

model ApprovalRequest {
  id              String         @id @default(uuid())
  taskId          String         @map("task_id")
  task            Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskExecutionId String         @map("task_execution_id")
  taskExecution   TaskExecution  @relation(fields: [taskExecutionId], references: [id], onDelete: Cascade)
  toolName        String         @map("tool_name")
  actionSummary   String         @map("action_summary")
  input           Json
  riskLevel       String         @map("risk_level")
  status          ApprovalStatus @default(PENDING)
  reviewedBy      String?        @map("reviewed_by")
  reviewedAt      DateTime?      @map("reviewed_at")
  rejectionReason String?        @map("rejection_reason")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([taskId])
  @@index([taskExecutionId])
  @@index([status])
  @@map("approval_requests")
}
